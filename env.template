# Viewpoint account used to log in to the JSON API.
VIEWPOINT_USER=you@example.com
VIEWPOINT_PASS=your-password

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?
MONGODB_DB_NAME=Acres-Props
MONGODB_COLLECTION_NAME=properties
MONGODB_SOLD_COLLECTION_NAME=sold_properties
MONGODB_RECENT_UPDATES_COLLECTION_NAME=recent_updates
MONGODB_GEOCODE_CACHE_COLLECTION_NAME=geocode_cache
MONGODB_SCRAPE_RUNS_COLLECTION_NAME=scrape_runs
MONGODB_LOCKS_COLLECTION_NAME=scraper_locks

# Never the same as MONGODB_DB_NAME; the test suite empties it.
MONGODB_TEST_DB_NAME=Acres-Props-Test

# "api" uses viewpoint's JSON API; "selenium" is the fallback transport.
SCRAPER_TRANSPORT=api

# Listings from our own database re-checked per run, oldest first. The activity
# feed never reports a listing that quietly expires, so this is what eventually
# notices. Set to 0 to disable.
STALE_RECHECK_LIMIT=25

# How long a change stays in recent_updates, and how long a run may hold the lock.
RECENT_UPDATES_TTL_SECONDS=86400
RUN_LOCK_TTL_SECONDS=3600

# Acres-API caches its property index for ten minutes. Setting this lets a run
# that changed something have the cache rebuilt immediately.
ACRES_API_URL=https://api.myacresapp.com
